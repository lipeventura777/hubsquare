{
  "name": "hubsquare",
  "version": "1.2.0",
  "description": "Servidor (ServSquare) e launcher (PlaySquare) de Minecraft Java no PC.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "test": "node --import ./tests/ts-sem-extensao.mjs --test \"tests/*.test.ts\"",
    "icone": "electron scripts/gerar-icone.mjs",
    "repro:modpack": "node --import ./scripts/repro-modpack/ganchos.mjs scripts/repro-modpack/repro.ts",
    "repro:modpack:electron": "rolldown -c scripts/repro-modpack/rolldown.config.mjs && node scripts/repro-modpack/electron.mjs .teste/repro-electron/entrada-electron.js",
    "repro:modpack:app": "node scripts/repro-modpack/electron.mjs scripts/repro-modpack/app-inteiro.mjs",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts --project=rapido",
    "test:e2e:lento": "npm run build && playwright test -c tests/e2e/playwright.config.ts --project=lento",
    "desempenho:fundo": "npm run build && playwright test -c tests/e2e/playwright.config.ts --project=desempenho",
    "ler-relatorio": "node scripts/ler-relatorio.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "marked": "^18.2.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.4"
  }
}
